# Gemini and Sarvam are needed for live voice. Missing keys keep startup healthy.
GEMINI_API_KEY=
SARVAM_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Separate text-only seller simulator for opt-in paid evaluations.
SELLER_SIM_MODEL=gemini-3.5-flash-lite
# Summarize consumed unsigned tool results; preserve all signed model Content.
# Experimental: keep off until a full live acceptance continuation passes.
COMPACT_TOOL_HISTORY=false
# Minimal thinking verified by P3 smoke:gemini; see docs/provider-notes.md.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_MS=8000
GEMINI_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_TEMPERATURE=0.4
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=transcribe
# Enable only after the bounded --hinglish smoke passes for this profile.
HINGLISH_ENABLED=false
SARVAM_HI_STT_MODEL=saaras:v4
SARVAM_HI_STT_MODE=codemix
SARVAM_HI_TTS_MODEL=bulbul:v4-flash
SARVAM_HI_TTS_SPEAKER=shubh_enhi_ads
SARVAM_HI_TTS_PACE=1
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
# Bulbul v3 requires a short speaker name, for example priya.
# REST always uses language_code; no language-field switch.
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TIMEOUT_MS=6000
SARVAM_RETRIES=1
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info
LOG_TRANSCRIPTS=false
SESSION_TTL_MS=1800000
SESSION_MAX_TURNS=25
SESSION_MAX_MS=600000
RATE_LIMIT_TURNS=40
RATE_LIMIT_WINDOW_MS=600000
DAILY_TURN_CAP=800
MAX_UTTERANCE_BYTES=1048576
MAX_UTTERANCE_MS=28000
MAX_QUESTIONS=3
MAX_TOOL_ROUNDS=4
# Writable append-only ledger directory; use /data with the P6 volume.
DATA_DIR=.data
# Read-only fixture source directory.
MOCK_DATA_DIR=data
# Optional user-entered code. Empty keeps the demo open.
DEMO_ACCESS_CODE=
# Only a proxy holding this secret may identify clients using X-Real-IP.
# Without it, unverified peers share one conservative rate bucket.
TRUSTED_PROXY_TOKEN=
# Direct run.app only after verifying its final forwarded-address slot.
# Local Compose / existing authenticated Caddy behavior remains the default.
PROXY_MODE=caddy
# Bearer secret for verbose health; empty denies verbose access, including localhost.
INTERNAL_METRICS_TOKEN=
# Optional JSON table override; billing units/schema are in src/lib/server/cost.ts.
PROVIDER_PRICING_JSON=
# Hostname only; HTTPS and DNS are configured in P6.
DOMAIN=
# Demo diagnostic rules, not Snapdeal policy. Percent values, not fractions.
ORDER_DROP_PCT=-15
ASP_FLAT_PCT=3
OOS_RATIO=2
OOS_INCREASE=5
CANCEL_INCREASE_PP=3
CONCENTRATION_PCT=70
STOCK_CANCEL_PCT=50
DISPATCH_CANCEL_PCT=40
