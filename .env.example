# Optional during P1: missing keys mean providers configured=false.
GEMINI_API_KEY=
SARVAM_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Thinking parameter mapping must be verified by P3 smoke:gemini.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_MS=8000
GEMINI_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_TEMPERATURE=0.4
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN
# Do not set SARVAM_STT_MODE or SARVAM_TTS_LANGUAGE_FIELD until P2 smoke:sarvam.
# SARVAM_STT_MODE=
# SARVAM_TTS_LANGUAGE_FIELD=target_language_code
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TIMEOUT_MS=6000
SARVAM_RETRIES=1
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info
LOG_TRANSCRIPTS=false
SESSION_TTL_MS=1800000
SESSION_MAX_TURNS=25
SESSION_MAX_MS=600000
RATE_LIMIT_TURNS=40
RATE_LIMIT_WINDOW_MS=600000
DAILY_TURN_CAP=800
MAX_UTTERANCE_BYTES=1048576
MAX_UTTERANCE_MS=28000
MAX_QUESTIONS=3
MAX_TOOL_ROUNDS=4
# Writable append-only ledger directory; use /data with the P6 volume.
DATA_DIR=.data
# Read-only fixture source directory.
MOCK_DATA_DIR=data
DEMO_ACCESS_CODE=
# Hostname only; HTTPS and DNS are configured in P6.
DOMAIN=
# Demo diagnostic rules, not Snapdeal policy. Percent values, not fractions.
ORDER_DROP_PCT=-15
ASP_FLAT_PCT=3
OOS_RATIO=2
OOS_INCREASE=5
CANCEL_INCREASE_PP=3
CONCENTRATION_PCT=70
STOCK_CANCEL_PCT=50
DISPATCH_CANCEL_PCT=40
