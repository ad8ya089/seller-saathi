{
  "name": "seller-saathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify-data && next build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-data": "node --conditions=react-server --import tsx scripts/verify-data.ts",
    "smoke:sarvam": "node scripts/pending.mjs smoke:sarvam P2",
    "smoke:gemini": "node scripts/pending.mjs smoke:gemini P3",
    "chat": "node scripts/pending.mjs chat P3",
    "eval": "node scripts/pending.mjs eval P5",
    "bench": "node scripts/pending.mjs bench P5"
  },
  "dependencies": {
    "next": "16.4.6",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
