{
	admin off
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
			}
		}
	}
}

{$DOMAIN} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "microphone=(self), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-X-Powered-By
		-Server
	}
	# Block every verbose query, including encoded/repeated values, before proxying.
	@verbose {
		path /api/health /api/health/
		query verbose=*
	}
	route {
		respond @verbose 404
		handle /api/turn {
			# No encode, no upstream compression, immediate downstream SSE flush.
			reverse_proxy app:3000 {
				flush_interval -1
				header_up Accept-Encoding identity
				header_up X-Internal-Proxy-Token "{env.TRUSTED_PROXY_TOKEN}"
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			encode zstd gzip
			reverse_proxy app:3000 {
				header_up X-Internal-Proxy-Token "{env.TRUSTED_PROXY_TOKEN}"
				header_up X-Real-IP {remote_host}
			}
		}
	}
}
